<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_kmessage_account_form" model="ir.ui.view">
        <field name="name">kmessage.account.form</field>
        <field name="model">kmessage.account</field>
        <field name="arch" type="xml">
            <form string="K-Message">
                <header>
                    <button name="action_test_connection" type="object" string="Test the connection"
                            class="btn-primary"/>
                    <button name="action_sync_templates" type="object" string="Refresh templates"
                            invisible="state != 'connected'"/>
                    <button name="action_setup_webhook" type="object" string="Set up the webhook"
                            invisible="state != 'connected'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,connected"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_messages" type="object" class="oe_stat_button" icon="fa-paper-plane">
                            <field name="message_count" widget="statinfo" string="Messages"/>
                        </button>
                        <button name="action_view_messages" type="object" class="oe_stat_button" icon="fa-exclamation-triangle"
                                invisible="failed_count == 0">
                            <field name="failed_count" widget="statinfo" string="Failed"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="K-Message"/></h1>
                    </div>
                    <group>
                        <group string="Connection">
                            <field name="base_url" groups="base.group_no_one"/>
                            <field name="api_key" password="True"/>
                            <field name="account_name" placeholder="the tenant's default number"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="remote_user" readonly="1" invisible="not remote_user"/>
                            <field name="last_check" readonly="1" invisible="not last_check"/>
                            <field name="last_error" readonly="1" invisible="not last_error" class="text-danger"/>
                        </group>
                        <group string="Switches">
                            <field name="outbound_enabled"/>
                            <field name="inbound_enabled"/>
                            <field name="dry_run"/>
                            <field name="active" widget="boolean_toggle"/>
                        </group>
                    </group>
                    <group string="What this token may do" invisible="state != 'connected'">
                        <group>
                            <field name="can_send" readonly="1"/>
                            <field name="can_read_templates" readonly="1"/>
                        </group>
                        <group>
                            <field name="can_list_webhooks" readonly="1"/>
                            <field name="provider_managed" readonly="1"/>
                        </group>
                    </group>
                    <group string="Webhook">
                        <div class="alert alert-info" role="alert" colspan="2"
                             invisible="webhook_state != 'manual'">
                            Your K-Message plan is managed by your provider, so only they can add the
                            subscription. Send them the address and the secret below and ask for the
                            events <b>message.incoming</b>, <b>message.sent</b>, <b>button.reply</b>
                            and <b>contact.created</b>.
                        </div>
                        <field name="webhook_url" readonly="1" widget="CopyClipboardChar"/>
                        <field name="webhook_secret" password="True"/>
                        <field name="webhook_state" readonly="1"/>
                    </group>
                    <notebook>
                        <page string="Templates" name="templates">
                            <field name="template_ids" readonly="1"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_kmessage_account_tree" model="ir.ui.view">
        <field name="name">kmessage.account.tree</field>
        <field name="model">kmessage.account</field>
        <field name="arch" type="xml">
            <tree string="K-Message">
                <field name="name"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="account_name"/>
                <field name="outbound_enabled"/>
                <field name="inbound_enabled"/>
                <field name="state" decoration-success="state == 'connected'" decoration-danger="state == 'error'" widget="badge"/>
                <field name="last_check"/>
            </tree>
        </field>
    </record>

    <record id="action_kmessage_account" model="ir.actions.act_window">
        <field name="name">Connection</field>
        <field name="res_model">kmessage.account</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Connect this Odoo to K-Message</p>
            <p>Paste the address of your K-Message service and the private token from it.
               Everything else — templates, the webhook, the token K-Message uses to ask
               about a customer — is set up from here.</p>
        </field>
    </record>
</odoo>
