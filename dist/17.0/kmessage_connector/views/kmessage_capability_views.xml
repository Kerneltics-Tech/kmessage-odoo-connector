<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_kmessage_capability_tree" model="ir.ui.view">
        <field name="name">kmessage.capability.tree</field>
        <field name="model">kmessage.capability</field>
        <field name="arch" type="xml">
            <tree string="What K-Message may ask" create="false" delete="false" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name" readonly="1"/>
                <field name="description" readonly="1" optional="show"/>
                <field name="endpoint" readonly="1" optional="hide"/>
                <field name="personal" readonly="1" string="About one customer"/>
                <field name="max_rows"/>
                <field name="available" readonly="1" string="Possible here"/>
                <field name="use_count" readonly="1" string="Used" optional="hide"/>
                <field name="last_used" readonly="1" optional="hide"/>
                <field name="active" widget="boolean_toggle" string="Allowed"/>
            </tree>
        </field>
    </record>

    <record id="action_kmessage_capability" model="ir.actions.act_window">
        <field name="name">What K-Message may ask</field>
        <field name="res_model">kmessage.capability</field>
        <field name="view_mode">tree</field>
        <field name="context">{'active_test': False}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Everything K-Message can ask this Odoo</p>
            <p>Each line is one question K-Message may put to Odoo on a customer's behalf.
               Untick one and it is refused from that moment, with a clear reason, for every
               token at once.</p>
        </field>
    </record>
</odoo>
