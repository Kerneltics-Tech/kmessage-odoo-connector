<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_partner_form_kmessage" model="ir.ui.view">
        <field name="name">res.partner.form.kmessage</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_kmessage_messages" type="object" class="oe_stat_button"
                        icon="fa-whatsapp" groups="kmessage_connector.group_kmessage_user"
                        invisible="kmessage_message_count == 0">
                    <field name="kmessage_message_count" widget="statinfo" string="WhatsApp"/>
                </button>
            </xpath>
            <xpath expr="//field[@name='category_id']" position="after">
                <field name="kmessage_opt_out" groups="kmessage_connector.group_kmessage_user"/>
                <field name="kmessage_phone_key" invisible="1"/>
            </xpath>
        </field>
    </record>
</odoo>
