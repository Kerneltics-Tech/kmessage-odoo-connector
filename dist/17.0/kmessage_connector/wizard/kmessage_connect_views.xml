<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_kmessage_connect_form" model="ir.ui.view">
        <field name="name">kmessage.connect.form</field>
        <field name="model">kmessage.connect</field>
        <field name="arch" type="xml">
            <form string="Connect to K-Message">
                <!-- Odoo 17 insists that a field driving a modifier is present
                     in the view, even when nothing renders it. -->
                <field name="state" invisible="1"/>
                <field name="needs_handover" invisible="1"/>
                <group invisible="state != 'start'">
                    <div class="text-muted" colspan="2">
                        Paste the private token from K-Message. Nothing is changed until you
                        press Connect.
                    </div>
                    <field name="api_key" password="True" placeholder="whm_…"/>
                    <field name="company_id" groups="base.group_multi_company"/>
                    <field name="elsewhere"/>
                    <field name="base_url" invisible="not elsewhere"
                           required="elsewhere"/>
                </group>

                <div invisible="state != 'checked'">
                    <div class="alert alert-success" role="alert">
                        The token works. It belongs to <field name="remote_user" readonly="1" nolabel="1" class="oe_inline"/>.
                    </div>
                    <group>
                        <group string="Found">
                            <field name="account_options" readonly="1" string="Numbers"/>
                            <field name="account_name"/>
                            <field name="template_total" readonly="1" string="Templates"/>
                        </group>
                        <group string="This token may">
                            <field name="can_send" readonly="1" string="Send messages"/>
                            <field name="can_list_webhooks" readonly="1" string="See the webhook list"/>
                            <field name="provider_managed" readonly="1" string="Plan managed by your provider"/>
                        </group>
                    </group>
                    <group string="Set up">
                        <field name="create_templates"/>
                        <field name="setup_webhook"/>
                        <field name="issue_token"/>
                        <field name="publish_tools"/>
                    </group>
                </div>

                <div invisible="state != 'done'">
                    <field name="summary" nolabel="1" readonly="1"/>
                    <group string="Give these to whoever administers K-Message"
                           invisible="not needs_handover">
                        <field name="webhook_url" readonly="1" widget="CopyClipboardChar"/>
                        <field name="webhook_secret" readonly="1" widget="CopyClipboardChar"/>
                    </group>
                    <div class="alert alert-warning" role="alert" invisible="not issued_token">
                        <b>Copy this token now.</b> Odoo keeps only a fingerprint of it, so it
                        cannot be shown again.
                        <field name="issued_token" readonly="1" nolabel="1" widget="CopyClipboardChar"/>
                    </div>
                </div>

                <footer>
                    <button name="action_check" type="object" string="Connect" class="btn-primary"
                            invisible="state != 'start'"/>
                    <button name="action_apply" type="object" string="Set it up" class="btn-primary"
                            invisible="state != 'checked'"/>
                    <button name="action_open_account" type="object" string="Open the connection"
                            class="btn-primary" invisible="state != 'done'"/>
                    <button string="Close" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_kmessage_connect" model="ir.actions.act_window">
        <field name="name">Connect to K-Message</field>
        <field name="res_model">kmessage.connect</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
