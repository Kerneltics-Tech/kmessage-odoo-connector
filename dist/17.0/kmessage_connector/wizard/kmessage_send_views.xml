<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_kmessage_send_form" model="ir.ui.view">
        <field name="name">kmessage.send.form</field>
        <field name="model">kmessage.send</field>
        <field name="arch" type="xml">
            <form string="Send on WhatsApp">
                <group>
                    <group>
                        <field name="record_name" readonly="1" string="About"/>
                        <field name="partner_id"/>
                        <field name="phone"/>
                        <field name="opted_out" invisible="not opted_out" readonly="1"/>
                    </group>
                    <group>
                        <field name="account_id"/>
                        <field name="template_id"/>
                        <field name="attach_document"/>
                    </group>
                </group>
                <div class="alert alert-warning" role="alert" invisible="not opted_out">
                    This customer has asked not to be messaged on WhatsApp.
                </div>
                <group string="Placeholders">
                    <field name="param_json" nolabel="1" colspan="2"/>
                </group>
                <group string="What they will read">
                    <field name="preview" nolabel="1" colspan="2" readonly="1"/>
                </group>
                <field name="res_model" invisible="1"/>
                <field name="res_id" invisible="1"/>
                <footer>
                    <button name="action_send" type="object" string="Send" class="btn-primary"
                            invisible="opted_out"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="view_kmessage_token_reveal_form" model="ir.ui.view">
        <field name="name">kmessage.token.reveal.form</field>
        <field name="model">kmessage.token.reveal</field>
        <field name="arch" type="xml">
            <form string="Your new token">
                <div class="alert alert-warning" role="alert">
                    <b>Copy this now.</b> Odoo keeps only a fingerprint, so it cannot be shown again.
                </div>
                <group>
                    <field name="raw_token" readonly="1" widget="CopyClipboardChar" nolabel="1"/>
                </group>
                <footer>
                    <button string="Done" class="btn-primary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
