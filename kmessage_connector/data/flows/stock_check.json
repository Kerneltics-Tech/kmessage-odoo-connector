{
  "name": "Odoo — is it in stock",
  "description": "Asks which product, then answers from Odoo's on-hand quantities. Edit the api_call node's url and Authorization header before enabling it.",
  "trigger_keywords": [
    "stock",
    "available",
    "in stock",
    "متوفر",
    "مخزون",
    "عندكم"
  ],
  "enabled": false,
  "graph": {
    "version": 2,
    "entry_node": "start",
    "nodes": [
      {
        "id": "start",
        "type": "start",
        "label": "Someone asked whether we have something",
        "position": {
          "x": 80,
          "y": 240
        },
        "config": {}
      },
      {
        "id": "ask_product",
        "type": "prompt",
        "label": "Which product?",
        "position": {
          "x": 300,
          "y": 240
        },
        "config": {
          "body": "Of course — which product should I check? The name or the code on the box is enough.",
          "store_as": "product_query",
          "validation_regex": ".{2,}",
          "validation_error": "I need a little more to go on — send the product name or its code.",
          "max_retries": 3
        }
      },
      {
        "id": "ask_odoo",
        "type": "api_call",
        "label": "Ask Odoo what is on hand",
        "position": {
          "x": 560,
          "y": 240
        },
        "config": {
          "url": "https://odoo.example.com/kmessage/api/v1/stock/check",
          "method": "POST",
          "headers": {
            "Authorization": "Bearer kmc_REPLACE_ME",
            "Content-Type": "application/json"
          },
          "body": "{\"product\": \"{{product_query}}\", \"limit\": 5}",
          "response_mapping": {
            "stock": "data.rows",
            "stock_count": "data.count",
            "product_name": "data.product"
          }
        }
      },
      {
        "id": "answer",
        "type": "message",
        "label": "Read the quantities back",
        "position": {
          "x": 820,
          "y": 140
        },
        "config": {
          "message": "{{if stock}}{{product_name}}:\n\n{{for item in stock}}• {{item.location}} — {{item.level}}\n{{endfor}}{{else}}We do not hold “{{product_query}}” at any branch right now.{{endif}}"
        }
      },
      {
        "id": "sorry",
        "type": "message",
        "label": "Could not answer",
        "position": {
          "x": 820,
          "y": 320
        },
        "config": {
          "message": "I could not check that one. Either we do not carry it under that name, or our system did not answer just now — the code printed on the box is the surest thing to send."
        }
      },
      {
        "id": "give_up",
        "type": "message",
        "label": "Asked three times",
        "position": {
          "x": 560,
          "y": 420
        },
        "config": {
          "message": "Let us leave it there for now. Send the product name whenever you have it to hand and I will check again."
        }
      },
      {
        "id": "end",
        "type": "end",
        "label": "Done",
        "position": {
          "x": 1060,
          "y": 240
        },
        "config": {}
      }
    ],
    "edges": [
      {
        "from": "start",
        "to": "ask_product",
        "condition": "default"
      },
      {
        "from": "ask_product",
        "to": "ask_odoo",
        "condition": "default"
      },
      {
        "from": "ask_product",
        "to": "give_up",
        "condition": "max_retries"
      },
      {
        "from": "ask_odoo",
        "to": "answer",
        "condition": "http:2xx"
      },
      {
        "from": "ask_odoo",
        "to": "sorry",
        "condition": "http:non2xx"
      },
      {
        "from": "answer",
        "to": "end",
        "condition": "default"
      },
      {
        "from": "sorry",
        "to": "end",
        "condition": "default"
      },
      {
        "from": "give_up",
        "to": "end",
        "condition": "default"
      }
    ]
  }
}
