<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_kmessage_reply_rule_list" model="ir.ui.view">
        <field name="name">kmessage.reply.rule.list</field>
        <field name="model">kmessage.reply.rule</field>
        <field name="arch" type="xml">
            <list string="Reply rules">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="button_id"/>
                <field name="button_text" optional="show"/>
                <field name="automation_id" optional="hide"/>
                <field name="model_id" optional="show"/>
                <field name="server_action_id"/>
                <field name="reply_template_id" optional="hide"/>
                <field name="run_count" string="Taps handled"/>
                <field name="last_run" optional="hide"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_kmessage_reply_rule_form" model="ir.ui.view">
        <field name="name">kmessage.reply.rule.form</field>
        <field name="model">kmessage.reply.rule</field>
        <field name="arch" type="xml">
            <form string="Reply rule">
                <sheet>
                    <widget name="web_ribbon" title="Off" bg_color="text-bg-secondary" invisible="active"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. “Yes, the amount arrived” marks the payment checked"/></h1>
                    </div>
                    <group>
                        <group string="When this comes back">
                            <field name="button_id" placeholder="approve"/>
                            <field name="button_text" placeholder="نعم، وصل المبلغ"/>
                            <field name="automation_id"/>
                            <field name="model_id"/>
                            <field name="model_name" invisible="1"/>
                        </group>
                        <group string="Do this">
                            <field name="account_id"/>
                            <field name="server_action_id"/>
                            <field name="reply_template_id"/>
                            <field name="once_only"/>
                            <field name="active" widget="boolean_toggle"/>
                        </group>
                    </group>
                    <div class="text-muted">
                        The action runs with the record the original message was about — the invoice,
                        the order, the delivery — so a tap can only ever change the thing it answered.
                    </div>
                    <group string="Results">
                        <field name="run_count" readonly="1"/>
                        <field name="last_run" readonly="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_kmessage_reply_rule" model="ir.actions.act_window">
        <field name="name">Reply rules</field>
        <field name="res_model">kmessage.reply.rule</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'active_test': False}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Make a tap do something</p>
            <p>When a customer taps a button on a message Odoo sent, a rule here can run an
               action on the record that message was about, and answer them back. Rules start
               switched off.</p>
        </field>
    </record>
</odoo>
