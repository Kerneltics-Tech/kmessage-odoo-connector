<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_kmessage_token_tree" model="ir.ui.view">
        <field name="name">kmessage.token.tree</field>
        <field name="model">kmessage.token</field>
        <field name="arch" type="xml">
            <list string="Tokens">
                <field name="name"/>
                <field name="token_hint"/>
                <field name="state" widget="badge" decoration-success="state == 'active'"
                       decoration-muted="state != 'active'"/>
                <field name="expires_on" optional="show"/>
                <field name="last_used"/>
                <field name="use_count"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_kmessage_token_form" model="ir.ui.view">
        <field name="name">kmessage.token.form</field>
        <field name="model">kmessage.token</field>
        <field name="arch" type="xml">
            <form string="Token">
                <header>
                    <button name="action_regenerate" type="object" string="Replace the secret"
                            confirm="Whatever uses this token now will stop working until the new one is pasted in. Continue?"/>
                    <button name="action_revoke" type="object" string="Revoke"
                            confirm="This token stops working immediately. Continue?"
                            invisible="not active"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="K-Message production"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="token_hint" readonly="1"/>
                            <field name="state" readonly="1"/>
                            <field name="expires_on"/>
                            <field name="rate_limit"/>
                        </group>
                        <group>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="last_used" readonly="1"/>
                            <field name="use_count" readonly="1"/>
                            <field name="active" widget="boolean_toggle"/>
                        </group>
                    </group>
                    <group string="May use">
                        <field name="capability_ids" widget="many2many_checkboxes" nolabel="1" colspan="2"
                               context="{'active_test': False}"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_kmessage_token" model="ir.actions.act_window">
        <field name="name">Tokens</field>
        <field name="res_model">kmessage.token</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'active_test': False}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">The keys K-Message uses to reach this Odoo</p>
            <p>A token is shown once, when it is issued. Odoo keeps only a fingerprint, so a
               lost token is replaced rather than recovered.</p>
        </field>
    </record>
</odoo>
