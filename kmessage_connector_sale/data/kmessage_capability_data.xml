<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Both are personal: they take the number K-Message is talking to and
             answer for that customer only. Neither can be asked about anybody
             else, because there is nothing in the request to ask with. -->
        <record id="capability_orders" model="kmessage.capability">
            <field name="code">orders</field>
            <field name="name">Recent orders</field>
            <field name="description">Given the number in the conversation, lists that customer's own quotations and orders, newest first, with what each came to and how far along it is.</field>
            <field name="endpoint">/kmessage/api/v1/orders</field>
            <field name="method">POST</field>
            <field name="personal" eval="True"/>
            <field name="max_rows">5</field>
            <field name="requires_module">sale</field>
            <field name="sequence">20</field>
        </record>

        <record id="capability_order_status" model="kmessage.capability">
            <field name="code">order_status</field>
            <field name="name">Status of one order</field>
            <field name="description">Given the number in the conversation and an order number, says where that order stands and what is on it. An order belonging to anyone else is answered as not found.</field>
            <field name="endpoint">/kmessage/api/v1/order/status</field>
            <field name="method">POST</field>
            <field name="personal" eval="True"/>
            <field name="max_rows">1</field>
            <field name="requires_module">sale</field>
            <field name="sequence">21</field>
        </record>
    </data>
</odoo>
