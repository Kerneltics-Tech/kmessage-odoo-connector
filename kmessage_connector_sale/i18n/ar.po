msgid "Ask for open, quotation, confirmed, done or cancelled orders."
msgstr "اطلب الطلبات بإحدى هذه الحالات: open أو quotation أو confirmed أو done أو cancelled."

#. module: kmessage_connector_sale
#. odoo-python
#: code:addons/kmessage_connector_sale/models/kmessage_ai_tool.py:0
msgid "Currency"
msgstr "العملة"

#. module: kmessage_connector_sale
#. odoo-python
#: code:addons/kmessage_connector_sale/models/kmessage_ai_tool.py:0
